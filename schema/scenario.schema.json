{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "agent-demo.scenario/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "default": "en",
      "type": "string",
      "minLength": 2
    },
    "viewport": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "const": 1920
        },
        "height": {
          "type": "number",
          "const": 1080
        },
        "deviceScaleFactor": {
          "type": "number",
          "const": 1
        }
      },
      "required": [
        "width",
        "height",
        "deviceScaleFactor"
      ]
    },
    "locale": {
      "type": "string",
      "const": "en-US"
    },
    "timezoneId": {
      "type": "string",
      "const": "UTC"
    },
    "colorScheme": {
      "type": "string",
      "const": "light"
    },
    "reducedMotion": {
      "type": "string",
      "const": "reduce"
    },
    "allowedConsoleErrors": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff": {
      "default": "none",
      "type": "string",
      "enum": [
        "none",
        "preflight",
        "session"
      ]
    },
    "handoffTimeoutMs": {
      "default": 120000,
      "type": "integer",
      "minimum": 5000,
      "maximum": 300000
    },
    "intro": {
      "type": "object",
      "properties": {
        "lines": {
          "minItems": 1,
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "narration": {
          "type": "string",
          "minLength": 1
        },
        "durationMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 15000
        }
      },
      "required": [
        "lines"
      ]
    },
    "camera": {
      "type": "object",
      "properties": {
        "maxZoom": {
          "type": "number",
          "minimum": 1,
          "maximum": 1.6
        },
        "margin": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "easeMs": {
          "type": "integer",
          "minimum": 133,
          "maximum": 2000
        },
        "minDwellMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        }
      }
    },
    "speech": {
      "type": "object",
      "properties": {
        "speed": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "voices": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pronunciations": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "id",
    "title",
    "viewport",
    "locale",
    "timezoneId",
    "colorScheme",
    "reducedMotion"
  ]
}
