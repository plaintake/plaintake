{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "agent-demo.scenario/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "default": "en",
      "type": "string",
      "minLength": 2
    },
    "viewport": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "const": 1920
        },
        "height": {
          "type": "number",
          "const": 1080
        },
        "deviceScaleFactor": {
          "type": "number",
          "const": 1
        }
      },
      "required": [
        "width",
        "height",
        "deviceScaleFactor"
      ]
    },
    "uiScale": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 1.5
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "locale": {
      "type": "string",
      "const": "en-US"
    },
    "timezoneId": {
      "type": "string",
      "const": "UTC"
    },
    "colorScheme": {
      "type": "string",
      "const": "light"
    },
    "reducedMotion": {
      "type": "string",
      "const": "reduce"
    },
    "allowedConsoleErrors": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff": {
      "default": "none",
      "type": "string",
      "enum": [
        "none",
        "preflight",
        "session"
      ]
    },
    "handoffTimeoutMs": {
      "default": 120000,
      "type": "integer",
      "minimum": 5000,
      "maximum": 300000
    },
    "intro": {
      "type": "object",
      "properties": {
        "lines": {
          "minItems": 1,
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "narration": {
          "type": "string",
          "minLength": 1
        },
        "durationMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 15000
        }
      },
      "required": [
        "lines"
      ]
    },
    "hook": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "durationMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 10000
            }
          },
          "required": [
            "text"
          ]
        }
      ]
    },
    "camera": {
      "type": "object",
      "properties": {
        "maxZoom": {
          "type": "number",
          "minimum": 1,
          "maximum": 1.6
        },
        "margin": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "easeMs": {
          "type": "integer",
          "minimum": 133,
          "maximum": 2000
        },
        "minDwellMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        }
      }
    },
    "speech": {
      "type": "object",
      "properties": {
        "speed": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "voices": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "terminal": {
      "type": "object",
      "properties": {
        "shell": {
          "default": "bash",
          "type": "string",
          "enum": [
            "bash",
            "zsh",
            "sh"
          ]
        },
        "command": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cols": {
          "default": 120,
          "type": "integer",
          "minimum": 40,
          "maximum": 200
        },
        "rows": {
          "default": 34,
          "type": "integer",
          "minimum": 12,
          "maximum": 60
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "env": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "secrets": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "browser": {
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "transition": {
          "type": "string",
          "enum": [
            "cut",
            "card"
          ]
        }
      }
    },
    "pronunciations": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "id",
    "title",
    "viewport",
    "locale",
    "timezoneId",
    "colorScheme",
    "reducedMotion"
  ]
}
